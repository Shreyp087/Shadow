APP_NAME=ShadowLedger API
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://shadowledger:shadowledger@localhost:5432/shadowledger
FRONTEND_ORIGIN=http://localhost:4200
# Encrypts saved target-system and per-role provider credentials.
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ENCRYPTION_KEY_PREVIOUS=
ALLOW_INSECURE_TARGET_ENDPOINTS=false
ALLOW_PRIVATE_TARGET_ENDPOINTS=false

# Hosted-role defaults. This key is only needed when a hosted Settings role has
# no saved provider-bound credential. Saved per-role Settings override models.
OPENAI_API_KEY=
OPENAI_ATTACKER_MODEL=gpt-4o-mini
OPENAI_MUTATION_MODEL=gpt-4o-mini
OPENAI_SCORER_MODEL=gpt-4o-mini

# Configure local LM Studio roles in Settings during development. Use a
# loopback URL such as http://127.0.0.1:1234/v1 and the exact chat model ID.

CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_FRONTEND_API_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:4200
NEXT_PUBLIC_DEMO_AUTH=true
