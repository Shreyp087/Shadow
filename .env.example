# npm-first local development configuration.
APP_NAME=ShadowLedger API
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://shadowledger:shadowledger@127.0.0.1:5432/shadowledger
# Optional Docker Compose override; npm does not use this value.
DOCKER_DATABASE_URL=postgresql+asyncpg://shadowledger:shadowledger@postgres:5432/shadowledger
FRONTEND_ORIGIN=http://localhost:4200
# Encrypts saved target-system and per-role provider credentials.
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Optional comma-separated old Fernet keys used only while re-encrypting during rotation.
ENCRYPTION_KEY_PREVIOUS=
# Off by default. Enable only for an explicitly authorized local/internal target.
ALLOW_INSECURE_TARGET_ENDPOINTS=false
ALLOW_PRIVATE_TARGET_ENDPOINTS=false

# Hosted-role defaults. OPENAI_API_KEY is only needed when at least one hosted
# role has no saved provider-bound key. An all-local Settings combination does
# not use it. Saved per-role Settings override these model defaults.
OPENAI_API_KEY=
OPENAI_ATTACKER_MODEL=gpt-4o-mini
OPENAI_MUTATION_MODEL=gpt-4o-mini
OPENAI_SCORER_MODEL=gpt-4o-mini

# Local LM Studio roles are configured in Settings, not here. In development,
# use a loopback base such as http://127.0.0.1:1234/v1 and an exact chat model
# ID such as mistralai/ministral-3-14b-reasoning.

# Demo auth is explicit and accepted only when ENVIRONMENT=development.
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_FRONTEND_API_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:4200

NEXT_PUBLIC_API_URL=http://localhost:8000
RAILWAY_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_AUTH=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
